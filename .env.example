PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
JWT_SECRET=change-me-to-a-long-random-string

# Optional. When set, the Kamptee project reads/writes this database instead
# of the dummy one (dummy_kamptee_fleet). Set this to fleet_kamptee once real
# mine data is ready — no code change needed.
# KAMPTEE_DB_NAME=fleet_kamptee

# Optional. Credentials for the demo "admin" user created by `npm run seed`.
# ADMIN_SEED_EMAIL=admin@bhushilp.local
# ADMIN_SEED_PASSWORD=Kamptee@123

# VECV (Volvo Eicher) Partner API — real telematics for Eicher-built vehicles.
# Leave unset to keep every vehicle on the simulated map/data path; the
# poller only starts once this is set AND at least one Vehicle document has
# data_source: "vecv_live". Never commit a real key here.
# VECV_API_KEY=
# Optional — only needed if VECV's gateway rejects calls without it (see
# services/vecv/client.js). Not required as of the first live test.
# VECV_CLIENT_ID=
# VECV rate limit per API key, shared across ALL data endpoints. Verified
# live as 1/min — only raise this if VECV upgrades your key's limit.
# VECV_REQUESTS_PER_MINUTE=1
# Set to true to log every VECV request with its HTTP status.
# VECV_DEBUG=true

# Second Eicher key (each key covers its own trucks; vehicles store which
# key they belong to in api_key_env).
# VECV_API_KEY_2=
# Volvo Connect API account (Administration > API Manager)
# VOLVO_API_USERNAME=
# VOLVO_API_PASSWORD=
# Production only: the dashboard URL(s) allowed to call the API.
# CORS_ORIGIN=https://bhushilp-dashboard.onrender.com
